generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Quiz {
  id        Int        @id @default(autoincrement())
  title     String
  questions Question[]
}

model Question {
  id        Int      @id @default(autoincrement())
  type      QuestionType
  question  String

  answers   Json?

  quizId    Int
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

enum QuestionType {
  BOOLEAN
  INPUT
  CHECKBOX
}
